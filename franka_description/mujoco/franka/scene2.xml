<mujoco model="panda scene">

  <include file="panda.xml"/>

  <extension>
    <plugin plugin="MujocoRosUtils::PosePublisher"/>
    <plugin plugin="MujocoRosUtils::ClockPublisher"/>
  </extension>  

  <statistic center="0.3 0 0.4" extent="1"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6"  ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="120" elevation="-20"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512"
        height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4"
        rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5"
        reflectance="0.2"/>

    <material name="red_box"   rgba="0.8 0.2 0.2 1"/>
    <material name="green_box" rgba="0.2 0.8 0.2 1"/>
    <material name="blue_box"  rgba="0.2 0.2 0.8 1"/>
  </asset>

  <worldbody>
    <light pos="0 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" size="0 0 0.05" type="plane" material="groundplane"/>

    <!-- Red cube is separated along +y, making red_cube leftOf green_cube -->
    <body name="red_cube" pos="-0.5 0.30 0.03">
      <freejoint/>
      <geom type="box" size="0.03 0.03 0.03" material="red_box"
            mass="0.5" friction="1 0.005 0.0001"/>
    </body>

    <!-- Green cube starts on the floor. -->
    <body name="green_cube" pos="-0.5 0.0 0.02">
      <freejoint/>
      <geom type="box" size="0.02 0.02 0.02" material="green_box"
            mass="0.3" friction="1 0.005 0.0001"/>
    </body>

    <!-- Blue cube starts beside and below the green cube. -->
    <body name="blue_cube" pos="-0.5 -0.10 0.01">
      <freejoint/>
      <geom type="box" size="0.01 0.01 0.01" material="blue_box"
            mass="0.1" friction="1 0.005 0.0001"/>
    </body>

    <plugin plugin="MujocoRosUtils::ClockPublisher">
      <config key="topic_name" value="/clock"/>
      <config key="publish_rate" value="100"/>
      <config key="use_sim_time" value="true"/>
    </plugin>
  </worldbody>

  <sensor>
    <plugin
        name="red_cube_pose_pub"
        plugin="MujocoRosUtils::PosePublisher"
        objtype="xbody"
        objname="red_cube">
      <config key="frame_id" value="world"/>
      <config key="pose_topic_name" value="/mujoco/red_cube/pose"/>
      <config key="vel_topic_name" value="/mujoco/red_cube/vel"/>
      <config key="publish_rate" value="30"/>
      <config key="output_tf" value="true"/>
      <config key="tf_child_frame_id" value="red_cube"/>
    </plugin>

    <plugin
        name="green_cube_pose_pub"
        plugin="MujocoRosUtils::PosePublisher"
        objtype="xbody"
        objname="green_cube">
      <config key="frame_id" value="world"/>
      <config key="pose_topic_name" value="/mujoco/green_cube/pose"/>
      <config key="vel_topic_name" value="/mujoco/green_cube/vel"/>
      <config key="publish_rate" value="30"/>
      <config key="output_tf" value="true"/>
      <config key="tf_child_frame_id" value="green_cube"/>
    </plugin>

    <plugin
        name="blue_cube_pose_pub"
        plugin="MujocoRosUtils::PosePublisher"
        objtype="xbody"
        objname="blue_cube">
      <config key="frame_id" value="world"/>
      <config key="pose_topic_name" value="/mujoco/blue_cube/pose"/>
      <config key="vel_topic_name" value="/mujoco/blue_cube/vel"/>
      <config key="publish_rate" value="30"/>
      <config key="output_tf" value="true"/>
      <config key="tf_child_frame_id" value="blue_cube"/>
    </plugin>
  </sensor>

</mujoco>
